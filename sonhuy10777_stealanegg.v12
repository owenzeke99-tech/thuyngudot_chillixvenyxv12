-- Main Script Loader
local hasLaunchedScript = false
local function RunMainScript()
	if hasLaunchedScript then
		return
	end
	hasLaunchedScript = true

	task.spawn(function()
		local ok, err = pcall(function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/thuyngudot42-svg/chilliv12/refs/heads/main/chilli-venyx-divine-sonhuy1077.Lua"))()
		end)
		if not ok then
			warn("[ChilliVenyxUI] Failed to load script:", err)
		end
	end)
end

