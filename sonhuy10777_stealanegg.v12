local function ShowNotice(message: string, success: boolean)
	Notice.Visible = true
	Notice.BackgroundColor3 = success and THEME.SuccessBg or THEME.ErrorBg
	NoticeStroke.Color = success and THEME.SuccessBorder or THEME.Red
	NoticeText.TextColor3 = success and THEME.SuccessText or THEME.ErrorText
	NoticeText.Text = message
end

-- Safe Shake relative to current position
local isShaking = false
local function Shake()
	if isShaking then
		return
	end
	isShaking = true

	local origin = Main.Position
	local offset = 8

	task.spawn(function()
		for i = 1, 4 do
			local dir = (i % 2 == 0) and offset or -offset
			local t = TweenService:Create(Main, TweenInfo.new(0.045), {
				Position = UDim2.new(origin.X.Scale, origin.X.Offset + dir, origin.Y.Scale, origin.Y.Offset),
			})
			t:Play()
			t.Completed:Wait()
		end

		local reset = TweenService:Create(Main, TweenInfo.new(0.1), {
			Position = origin,
		})
		reset:Play()
		reset.Completed:Wait()
		isShaking = false
	end)
end

-- Clear text simultaneously with shake on invalid input
local function RejectInput(message: string)
	ShowNotice(message, false)
	Input.Text = ""
	Input.TextXAlignment = Enum.TextXAlignment.Left
	Shake()
end

local function OnKeyAccepted(key: string)
	WriteKeyCache(key, os.time())
	ShowNotice("Key valid!", true)

	task.delay(0.35, function()
		if ScreenGui and ScreenGui.Parent then
			ScreenGui:Destroy()
		end
		RunMainScript()
	end)
end

-- Button handlers
Check.MouseButton1Click:Connect(function()
	local entered = Input.Text:match("^%s*(.-)%s*$") or ""
	if entered == "" then
		RejectInput("Please enter a key!")
		return
	end

	if IsKeyValid(entered) then
		OnKeyAccepted(entered)
	else
		RejectInput("Invalid key!")
	end
end)

GetKey.MouseButton1Click:Connect(function()
	if CopyToClipboard(GET_KEY_URL) then
		ShowNotice("Key link copied to clipboard!", true)
	else
		ShowNotice("Get Key link: " .. GET_KEY_URL, false)
	end
end)

