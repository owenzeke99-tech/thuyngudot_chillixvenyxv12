end)

-- Entrance animation
local targetScale = Scale.Scale
Scale.Scale = math.max(targetScale * 0.75, 0.5)
TweenService:Create(
	Scale,
	TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	{ Scale = targetScale }
):Play()

