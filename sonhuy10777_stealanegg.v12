local MAIN_CENTER = UDim2.new(0.5, -MAIN_SIZE.X.Offset / 2, 0.5, -MAIN_SIZE.Y.Offset / 2)

-- Helpers: Clipboard & File cache
local function CopyToClipboard(text: string): boolean
	local clipFn = (typeof(setclipboard) == "function" and setclipboard)
		or (typeof(toclipboard) == "function" and toclipboard)
		or (typeof(set_clipboard) == "function" and set_clipboard)

	if clipFn then
		local ok = pcall(clipFn, text)
		return ok
	end
	return false
end

local memoryCache: { key: string, savedAt: number }? = nil

local function ReadKeyCache(): { key: string, savedAt: number }?
	if typeof(isfile) == "function" and typeof(readfile) == "function" then
		local existsOk, exists = pcall(isfile, CACHE_FILE)
		if existsOk and exists then
			local readOk, raw = pcall(readfile, CACHE_FILE)
			if readOk and type(raw) == "string" then
				local decodeOk, decoded = pcall(function()
					return HttpService:JSONDecode(raw)
				end)
				if decodeOk and type(decoded) == "table" and type(decoded.key) == "string" and type(decoded.savedAt) == "number" then
					return decoded
				end
			end
		end
	end
	return memoryCache
end

local function WriteKeyCache(key: string, savedAt: number)
	local payload = { key = key, savedAt = savedAt }
	memoryCache = payload

	if typeof(writefile) == "function" then
		local encoded = HttpService:JSONEncode(payload)
		pcall(writefile, CACHE_FILE, encoded)
	end
end

local function IsKeyValid(key: string): boolean
	return VALID_KEYS[key] == true
end

local function HasValidCachedKey(): boolean
	local cached = ReadKeyCache()
	if not cached then
		return false
	end

	local elapsed = os.time() - cached.savedAt
	if elapsed < 0 or elapsed > KEY_TTL_SECONDS then
		return false
	end

	return IsKeyValid(cached.key)
end

-- Auto-run if valid key was saved within 24 hours
if HasValidCachedKey() then
	local cached = ReadKeyCache()
	if cached then
		WriteKeyCache(cached.key, cached.savedAt)
	end
	RunMainScript()
	return
end

