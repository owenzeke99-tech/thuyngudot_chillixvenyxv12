local function CreateButton(name: string, text: string, baseColor: Color3, hoverColor: Color3)
	local Button = Instance.new("TextButton")
	Button.Name = name
	Button.Size = UDim2.new(0.5, -5, 1, 0)
	Button.BackgroundColor3 = baseColor
	Button.BorderSizePixel = 0
	Button.Text = text
	Button.TextColor3 = THEME.White
	Button.TextSize = 14
	Button.Font = Enum.Font.GothamBlack
	Button.AutoButtonColor = false
	Button.Parent = Buttons

	Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 9)

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = hoverColor
	Stroke.Thickness = 1
	Stroke.Transparency = 0.55
	Stroke.Parent = Button

	local activeTween: Tween?
	local function tweenBg(targetColor: Color3)
		if activeTween then
			activeTween:Cancel()
		end
		activeTween = TweenService:Create(Button, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = targetColor,
		})
		activeTween:Play()
	end

	Button.MouseEnter:Connect(function()
		tweenBg(hoverColor)
	end)

	Button.MouseLeave:Connect(function()
		tweenBg(baseColor)
	end)

	return Button
end

